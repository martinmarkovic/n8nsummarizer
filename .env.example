# n8n Summarizer Application Settings
# Copy this file to .env and customize your settings

# === Application Window Settings ===
# Last active tab (0=Summarizer, 1=Translator, 2=Downloader)
LAST_ACTIVE_TAB=0

# === Downloader Settings ===
# Last selected download folder path
DOWNLOADER_SAVE_PATH=

# Last selected video quality/resolution
# Options: Best Available, 2160p (4K), 1440p (2K), 1080p (Full HD), 720p (HD), 480p, 360p, Audio Only (MP3)
DOWNLOADER_QUALITY=Best Available

# === YouTube PO Token (Optional - for HD quality) ===
# PO Token for accessing 720p+ quality (expires periodically)
# See: https://github.com/yt-dlp/yt-dlp/wiki/PO-Token-Guide
YOUTUBE_PO_TOKEN=

# === LLM Webhook (direct summarization - works with LM Studio, Ollama, any OpenAI-compatible server) ===
# LLM Webhook URL for direct language model access
LLM_WEBHOOK_URL=http://localhost:1234

# Default model to use for LLM operations
LLM_MODEL=local-model

# Timeout for LLM webhook requests in seconds
LLM_TIMEOUT=120

# LLM API Format (true for OpenAI format, false for simple prompt format)
# Set to false if using LM Studio or similar servers that expect simple prompt format
LLM_USE_OPENAI_FORMAT=true

# === Instagram Settings (for private content) ===
# Path to cookies.txt file for Instagram authentication
INSTAGRAM_COOKIE_FILE=

# Browser to extract cookies from (chrome, firefox, edge, safari, chromium)
# Alternative to cookie file - requires browser to be running
INSTAGRAM_COOKIE_BROWSER=

# === Facebook Settings (for private content) ===
# Path to cookies.txt file for Facebook authentication
FACEBOOK_COOKIE_FILE=

# Browser to extract cookies from (chrome, firefox, edge, safari, chromium)
# Alternative to cookie file - requires browser to be running
FACEBOOK_COOKIE_BROWSER=

# === Summarizer Settings (from existing config.json) ===
# These are read from config.json, not .env
# LLM_MODEL=
# LLM_API_URL=
# LLM_API_KEY=
# etc...

# === Appearance Settings ===
# UI language (chosen from Settings → Appearance → Language; applied on restart)
# Options: en (English), hr (Hrvatski)
APP_LANGUAGE=en

# Custom theme colors (overrides the built-in light/dark palette).
# Set to a hex color like #1a1d21, or leave blank to use the default palette.
#   APP_COLOR_BG     — window/text-area background
#   APP_COLOR_TEXT   — main text (letters) color
#   APP_COLOR_ACCENT — borders, buttons, tabs, section labels, secondary text
APP_COLOR_BG=
APP_COLOR_TEXT=
APP_COLOR_ACCENT=

# Application theme (light or dark — toggled from the header button)
# APP_THEME=light

# Font size in pixels (8–20, any integer)
# APP_FONT_SIZE=10

# === Paths ===
# Override the built-in executable paths.  Leave blank to use the hardcoded
# defaults or system PATH lookup.

# Path to ffmpeg executable (leave blank to use 'ffmpeg' from system PATH)
FFMPEG_PATH=

# (Advanced / optional) Path to the transcribe-anything executable.
# transcribe-anything is a pip package managed from the Dependencies Manager,
# so this normally stays blank (resolved via the venv / system PATH). Set it
# only if you need to point at a specific executable. There is no UI field.
# TRANSCRIBE_PATH=
